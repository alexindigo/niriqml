#!/usr/bin/env bash
set -euo pipefail

source "$(dirname -- "$0")/build-paths.sh"
resolve_build_dir "${BUILD_DIR:-build-release}"
require_build_dir
[[ -f "${BUILD_DIR}/Niri/libniriqmlplugin.so" ]] || fail "build the QML plugin first: ${BUILD_DIR}"
[[ -n "${NIRI_SOCKET:-}" ]] || fail "set NIRI_SOCKET to the intended test compositor endpoint"

export NIRI_SOCKET

echo "Starting niriqml dashboard..."
echo "  Import path: ${BUILD_DIR}"
echo "  Socket: $NIRI_SOCKET"
echo ""

QML_IMPORT_PATH="${BUILD_DIR}" qml6 "${PROJECT_DIR}/examples/DashboardVisualizer.qml" "$@"
